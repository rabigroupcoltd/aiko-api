# ---------------------------------------------------------------- core
# development | production — production hides internal error details in responses
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rabi?schema=public"
JWT_SECRET="rabi-jwt-secret-key-change-in-production"
PORT=3000
PUBLIC_BASE_URL="http://localhost:3000"
# Comma-separated list, or omit for "*"
# CORS_ORIGIN="http://localhost:8081,https://admin.aiko.ng"

# ------------------------------------------------------------ firebase
# Verifies the ID tokens sent to POST /api/auth/firebase — the app's only way
# in. Without these the endpoint rejects every request and the API logs a
# warning at boot; everything else still runs.
#
# Take the values from the service account JSON (Firebase console -> Project
# settings -> Service accounts -> Generate new private key). Do NOT commit the
# file itself.
FIREBASE_PROJECT_ID=aiko-7874b
FIREBASE_CLIENT_EMAIL=
# Paste the whole key on one line, keeping the literal \n sequences, in quotes:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Alternative to the three above — point at the service account file instead and
# leave them blank. Only one of the two approaches is needed.
# GOOGLE_APPLICATION_CREDENTIALS=../aiko-7874b-firebase-adminsdk.json

# --------------------------------------------------- push notifications
# Sent through FCM with the same credentials as above — nothing extra to
# configure. Without them push is skipped silently and the socket remains the
# only delivery path.
#
# Android channel for ride notifications. It MUST match the channel the app
# creates at startup (see aiko/src/services/notificationChannel.ts) and the
# `messaging_android_notification_channel_id` in aiko/firebase.json — naming a
# channel the client has not created makes Android fall back to the low-priority
# "Miscellaneous" default, which loses the heads-up banner rather than gaining
# it. All three names have to agree or a driver gets a silent tray entry they
# will not notice while driving.
FCM_RIDE_CHANNEL_ID=aiko-orders
# How long FCM may hold a trip update for a device that is offline. Ride offers
# use RIDE_REQUEST_TTL instead — they are worthless once the request has closed.
PUSH_TRIP_TTL=1800

# --------------------------------------------------------------- redis
REDIS_URL="redis://localhost:6379"
# How long a driver stays in the dispatch pool after their last position.
# Sized for a backgrounded driver whose fixes Android may defer — see
# redis.keys.ts. Must stay comfortably above the app's publish interval.
DRIVER_HEARTBEAT_TTL=90

# ------------------------------------------------------------- storage
# LOCAL | CLOUDINARY | S3 | CLOUDFLARE_R2
STORAGE_PROVIDER=LOCAL
MAX_UPLOAD_BYTES=5242880
MAX_VEHICLE_PHOTOS=6

# STORAGE_PROVIDER=LOCAL
UPLOAD_DIR=./uploads

# STORAGE_PROVIDER=CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# STORAGE_PROVIDER=S3
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CDN / custom domain in front of the bucket
AWS_S3_PUBLIC_URL=

# STORAGE_PROVIDER=CLOUDFLARE_R2
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Defaults to https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=
# R2 buckets are private by default — set the public r2.dev or custom domain
R2_PUBLIC_URL=

# ------------------------------------------------------------- pricing
# Fares round up to a multiple of this
FARE_ROUNDING_STEP=10
# Straight-line distance is multiplied by this to approximate road distance
ROAD_DISTANCE_FACTOR=1.3

# ------------------------------------------------------------ matching
SEARCH_RADIUS_KM=5
MAX_MATCHED_DRIVERS=15
RIDE_REQUEST_TTL=120
MATCHING_RETRIES=3
MATCHING_RETRY_DELAY_MS=15000
LOCATION_FLUSH_INTERVAL_MS=30000
# Shortest gap between two backfill sweeps for one driver. A driver reports a
# position every ~10s and each one announces them as available; this is what
# stops that from re-running the open-request sweep six times a minute.
DRIVER_SWEEP_THROTTLE=30
# true lets an accepted bid set the fare (within +/-50% of the quote)
ALLOW_BID_FARE_OVERRIDE=false

# --------------------------------------------------------- marketplace
# The multi-order driver marketplace. Every value here is enforced server-side
# and echoed to the client through GET /api/marketplace/config — the app never
# carries its own copy of a limit it does not own.

# How many orders one driver may hold at once, reserved or picked up.
MAX_RESERVED_ORDERS_PER_DRIVER=3

# First ring searched around a new order's pickup, and how far it may grow.
INITIAL_DRIVER_RADIUS_KM=5
MAX_DRIVER_RADIUS_KM=10
RADIUS_EXPANSION_FACTOR=2
# How long a pass runs before the ring widens, and how many passes before the
# order is closed as NO_DRIVER_FOUND.
DISPATCH_EXPAND_DELAY_MS=45000
MAX_DISPATCH_ATTEMPTS=3

# Route compatibility. The allowance is the LARGER of the two: a flat floor
# every route gets, and a share that scales it up for long routes. Taking the
# smaller instead would mean a 5 km route allows only 1 km, which rejects nearly
# every second order.
MAX_ROUTE_DETOUR_KM=3
MAX_ROUTE_DETOUR_PERCENT=20
# How much later an already-committed customer may be served because of a new
# order. This is what stops a driver trading someone else's delivery time for an
# extra fare.
MAX_EXISTING_ORDER_DELAY_MINUTES=8

# true lets a driver reserve an order the compatibility engine rejected. Off by
# default — incompatible orders are still shown, and still labelled POOR, but
# cannot be taken.
ALLOW_INCOMPATIBLE_RESERVATION=false

# How long a skipped order stays out of that driver's grid. 0 means forever.
SKIP_COOLDOWN_MINUTES=0

# A position older than this cannot place a driver for dispatch.
DRIVER_LOCATION_STALE_SECONDS=120
MARKETPLACE_PAGE_SIZE=20
# Fallback planning speed when a vehicle's pricing rule has no avgSpeedKph.
DEFAULT_AVG_SPEED_KPH=25

# -------------------------------------------------------------- wallet
# Smallest payout a driver may request
MIN_WITHDRAWAL=500

# -------------------------------------------------------------- places
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_REGION=ng

# ---------------------------------------------------------------- seed
SEED_ADMIN_EMAIL=admin@aiko.ng
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_PHONE=+2348000000000

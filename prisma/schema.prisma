generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  RIDER
  ADMIN
  SUPPORT
}

enum AuthProvider {
  FIREBASE_GOOGLE
  FIREBASE_PHONE
  PASSWORD
}

enum AccountType {
  PASSENGER
  RIDER
}

enum OnboardingStep {
  PHONE
  PROFILE
  PHOTO
  LIVENESS
  USER_TYPE
  RIDER_DOCS
  AWAITING_APPROVAL
  DONE
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  SEARCHING_FOR_DRIVER
  RESERVED
  DRIVER_ARRIVING_PICKUP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  NO_DRIVER_FOUND
}

enum DriverOrderActionType {
  SKIPPED
  RESERVED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum TransactionType {
  RIDE_EARNINGS
  PLATFORM_FEE
  WITHDRAWAL
  DEBT_PAYMENT
  ADJUSTMENT
}

enum VehicleType {
  CAR
  BIKE
  TRUCK
  TRICYCLE
  BICYCLE
}

enum StorageProvider {
  LOCAL
  CLOUDINARY
  S3
  CLOUDFLARE_R2
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum VehiclePhotoType {
  FRONT
  BACK
  SIDE
  INTERIOR
  PLATE_NUMBER
  DRIVER_LICENSE
  NATIONAL_ID
  OTHER
}

enum RideRequestStatus {
  PENDING
  MATCHED
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model User {
  id String @id @default(uuid())

  email String? @unique
  password String?
  firebaseUid String? @unique

  authProvider  AuthProvider @default(PASSWORD)
  emailVerified Boolean      @default(false)
  phoneVerified Boolean      @default(false)

  name      String?
  firstName String?
  lastName  String?
  phone String?
  dob   DateTime?
  photoUrl String?

  roles UserRole[]

  isBlocked     Boolean @default(false)
  blockedReason String?

  accountType           AccountType?
  onboardingStep        OnboardingStep @default(PHONE)
  onboardingCompletedAt DateTime?
  profilePhotoUrl String?
  profilePhotoKey String?
  livenessPassedAt DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  driver       Driver?
  orders       Order[]       @relation("UserOrders")
  addresses    Address[]
  rideRequests RideRequest[]
  messages     RideMessage[]
  ratingsGiven RideRating[]  @relation("RatingsGiven")
  deviceTokens DeviceToken[]
  auditLogs        AuditLog[]       @relation("AuditActor")
  ticketsRaised    SupportTicket[]  @relation("TicketRequester")
  ticketsAssigned  SupportTicket[]  @relation("TicketAssignee")
  supportMessages  SupportMessage[] @relation("SupportSender")
}

model DeviceToken {
  id       String         @id @default(uuid())
  userId   String
  token    String         @unique
  platform DevicePlatform @default(ANDROID)
  deviceId   String?
  deviceName String?
  appVersion String?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("device_tokens")
}

model Driver {
  id                 String      @id @default(uuid())
  userId             String      @unique
  vehicleType        VehicleType
  vehiclePlate       String
  vehicleBrand       String?
  vehicleModel       String?
  vehicleColor       String?
  vehicleYear        Int?
  kycStatus          KycStatus   @default(PENDING)
  kycRejectionReason String?
  isAvailable        Boolean     @default(false)
  isBlocked          Boolean     @default(false)
  debtLimit          Float?
  currentDebt        Float       @default(0)
  rating             Float       @default(5.0)
  ratingCount        Int         @default(0)
  totalTrips         Int         @default(0)
  acceptedTrips      Int         @default(0)
  cancelledTrips     Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user          User                @relation(fields: [userId], references: [id])
  wallet        DriverWallet?
  orders        Order[]             @relation("DriverOrders")
  transactions  LedgerTransaction[]
  vehiclePhotos VehiclePhoto[]
  location      DriverLocation?
  bids          RideBid[]
  orderActions  DriverOrderAction[]

  @@index([vehicleType, isAvailable, kycStatus])
}

model VehiclePhoto {
  id        String           @id @default(uuid())
  driverId  String
  type      VehiclePhotoType @default(OTHER)
  url       String
  key       String
  provider  StorageProvider
  mimeType  String?
  sizeBytes Int?
  createdAt DateTime         @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@map("vehicle_photos")
}

model DriverLocation {
  driverId       String   @id
  latitude       Float
  longitude      Float
  heading        Float?
  speedKph       Float?
  accuracyMeters Float?
  recordedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([latitude, longitude])
  @@map("driver_locations")
}

model PricingRule {
  id                 String      @id @default(uuid())
  vehicleType        VehicleType @unique
  baseFare           Float       @default(0)
  perKm              Float       @default(0)
  perMinute          Float       @default(0)
  minimumFare        Float       @default(0)
  bookingFee         Float       @default(0)
  surgeMultiplier    Float       @default(1)
  avgSpeedKph        Float       @default(25)
  platformFeePercent Float       @default(10)
  currency           String      @default("NGN")
  isActive           Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@map("pricing_rules")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  name      String?
  address   String
  latitude  Float?
  longitude Float?
  placeId   String?
  source    String   @default("CACHED")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([address, userId])
  @@index([latitude, longitude])
  @@index([placeId])
  @@map("addresses")
}

model PlaceCache {
  id          String   @id @default(uuid())
  placeId     String?  @unique
  name        String
  address     String   @unique
  latitude    Float
  longitude   Float
  searchCount Int      @default(1)
  category String?
  searchText String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([latitude, longitude])
  @@map("place_cache")
}

model RideRequest {
  id               String            @id @default(uuid())
  userId           String
  vehicleType      VehicleType
  pickupLocation   String
  dropoffLocation  String
  pickupLat        Float
  pickupLng        Float
  dropoffLat       Float
  dropoffLng       Float
  distanceKm       Float             @default(0)
  durationMins     Float             @default(0)
  estimatedFare    Float             @default(0)
  paymentMethod    PaymentMethod     @default(CASH)
  status           RideRequestStatus @default(PENDING)
  expiresAt        DateTime
  matchedDriverIds String[]
  orderId          String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order?    @relation(fields: [orderId], references: [id])
  bids  RideBid[]

  @@index([status, createdAt])
  @@map("ride_requests")
}

model RideBid {
  id        String    @id @default(uuid())
  requestId String
  driverId  String
  amount    Float
  note      String?
  status    BidStatus @default(PENDING)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  request RideRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  driver  Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([requestId, driverId])
  @@index([requestId, status])
  @@map("ride_bids")
}

model Order {
  id                 String        @id @default(uuid())
  userId             String
  driverId           String?
  vehicleType        VehicleType
  description        String?       @db.VarChar(500)
  pickupLocation     String
  dropoffLocation    String
  pickupLat          Float
  pickupLng          Float
  dropoffLat         Float
  dropoffLng         Float
  pickupPhone        String?
  dropoffPhone       String?
  distanceKm         Float         @default(0)
  durationMins       Float         @default(0)
  fare               Float
  currency           String        @default("NGN")
  pricingSnapshot    Json?
  status             OrderStatus   @default(PENDING)
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus @default(PENDING)
  platformFee        Float         @default(0)
  driverEarnings     Float         @default(0)
  cancellationReason String?
  acceptedAt         DateTime?
  reservedAt         DateTime?
  arrivedAt          DateTime?
  startedAt          DateTime?
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  searchRadiusKm     Float?
  dispatchAttempts   Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user         User                @relation("UserOrders", fields: [userId], references: [id])
  driver       Driver?             @relation("DriverOrders", fields: [driverId], references: [id])
  rideRequest  RideRequest?
  messages     RideMessage[]
  ratings      RideRating[]
  driverActions DriverOrderAction[]
  supportTickets SupportTicket[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([driverId, createdAt])
  @@index([status, pickupLat, pickupLng])
}

model DriverOrderAction {
  id          String                @id @default(uuid())
  orderId     String
  driverId    String
  action      DriverOrderActionType
  hiddenUntil DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([orderId, driverId])
  @@index([driverId, action])
  @@map("driver_order_actions")
}

model RideMessage {
  id        String    @id @default(uuid())
  orderId   String
  senderId  String
  content   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("ride_messages")
}

model RideRating {
  id        String   @id @default(uuid())
  orderId   String
  raterId   String
  rateeId   String
  score     Int
  comment   String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rater User  @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)

  @@unique([orderId, raterId])
  @@index([rateeId])
  @@map("ride_ratings")
}

model DriverWallet {
  id               String   @id @default(uuid())
  driverId         String   @unique
  totalEarnings    Float    @default(0)
  totalWithdrawals Float    @default(0)
  totalDebt        Float    @default(0)
  availableBalance Float    @default(0)
  pendingBalance   Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  driver Driver @relation(fields: [driverId], references: [id])
}

model LedgerTransaction {
  id           String          @id @default(uuid())
  driverId     String
  type         TransactionType
  amount       Float
  balanceAfter Float
  reference    String
  description  String
  createdAt    DateTime        @default(now())

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId, createdAt])
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnalyticsSnapshot {
  id               String   @id @default(uuid())
  date             DateTime @unique
  totalUsers       Int      @default(0)
  totalDrivers     Int      @default(0)
  activeDrivers    Int      @default(0)
  totalOrders      Int      @default(0)
  completedOrders  Int      @default(0)
  cancelledOrders  Int      @default(0)
  cashRevenue      Float    @default(0)
  transferRevenue  Float    @default(0)
  platformEarnings Float    @default(0)
  outstandingDebt  Float    @default(0)
  createdAt        DateTime @default(now())
}

enum AuditEntity {
  DRIVER
  USER
  ORDER
  WALLET
  PRICING
  SUPPORT
  SYSTEM
}

model AuditLog {
  id        String      @id @default(uuid())
  actorId   String?
  actorName String?
  actorRole String?
  action    String
  entity    AuditEntity
  entityId  String?
  summary   String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

enum SupportStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model SupportTicket {
  id         String          @id @default(uuid())
  reference  String          @unique
  requesterId String
  orderId    String?
  subject    String
  category   String?
  status     SupportStatus   @default(OPEN)
  priority   SupportPriority @default(NORMAL)
  assigneeId String?
  lastMessageAt DateTime     @default(now())
  resolvedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  requester User             @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee  User?            @relation("TicketAssignee", fields: [assigneeId], references: [id])
  order     Order?           @relation(fields: [orderId], references: [id])
  messages  SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([requesterId, createdAt])
  @@index([assigneeId, status])
}

model SupportMessage {
  id        String   @id @default(uuid())
  ticketId  String
  senderId  String
  fromStaff Boolean  @default(false)
  internal  Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation("SupportSender", fields: [senderId], references: [id])

  @@index([ticketId, createdAt])
}
